        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить данные просмотра"
          }
        }
      }
    },
    "Hidden addresses appear as dots in tab and library lists. Touch and hold one to reveal it for five seconds.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытые адреса отображаются точками в списках вкладок и библиотеки. Нажмите на адрес и удерживайте, чтобы показать его на пять секунд."
          }
        }
      }
    },
    "Clear all history and website data?": {
      "localizations": {
        "ru": {
