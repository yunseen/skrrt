{
  "sourceLanguage": "en",
  "strings": {
    "Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основные"
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системная"
          }
        }
      }
    },
    "Site Mode": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим сайта"
          }
        }
      }
    },
    "Search Engine": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поисковая система"
          }
        }
      }
    },
    "Chrome mode identifies Skrrt as Chrome. Desktop mode asks sites for their desktop version.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим Chrome представляет Skrrt как Chrome. Режим Desktop запрашивает у сайтов компьютерную версию."
          }
        }
      }
    },
    "Desktop": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютер"
          }
        }
      }
    },
    "Privacy": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфиденциальность"
          }
        }
      }
    },
    "Block Ads and Trackers": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировать рекламу и трекеры"
          }
        }
      }
    },
    "Hide Addresses": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывать адреса"
          }
        }
      }
    },
    "Clear Browsing Data": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить данные просмотра"
          }
        }
      }
    },
    "Hidden addresses appear as dots in tab and library lists. Tap one to reveal it for five seconds.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытые адреса отображаются точками в списках вкладок и библиотеки. Нажмите на адрес, чтобы показать его на пять секунд."
          }
        }
      }
    },
    "Clear all history and website data?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить всю историю и данные сайтов?"
          }
        }
      }
    },
    "Clear Everything": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить всё"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформление"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема"
          }
        }
      }
