    "Hide cookie banners, force dark mode or add your own scripts and styles.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывайте баннеры cookie, включайте тёмный режим или добавляйте свои скрипты и стили."
          }
        }
      }
    },
