      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrrt это свободное программное обеспечение под лицензией GPL-3.0."
          }
        }
      }
    },
    "Search": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск"
          }
        }
      }
    },
    "Library": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Библиотека"
          }
        }
      }
    },
