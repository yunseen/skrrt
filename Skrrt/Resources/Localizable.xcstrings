      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсказки при поиске"
          }
        }
      }
    },
    "Put %s where the search words should go. Suggestions and results use the same engine.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте %s туда, где должен быть запрос. Подсказки и результаты используют один движок."
          }
        }
      }
    },
    "Suggestions and results use the same engine.": {
      "localizations": {
