    "Chrome mode identifies Skrrt as Chrome. Desktop mode asks sites for their desktop version.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим Chrome представляет Skrrt как Chrome. Режим Desktop запрашивает у сайтов компьютерную версию."
          }
        }
      }
    },
