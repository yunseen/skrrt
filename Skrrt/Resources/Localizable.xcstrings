          }
        }
      }
    },
    "Touch and hold a shortcut on the home screen to edit or delete it. Tap Add to create your own and the logo is found automatically.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зажмите ярлык на главном экране, чтобы изменить или удалить его. Нажмите «Добавить», чтобы создать свой: логотип найдётся сам."
          }
        }
      }
    },
    "Restore the default shortcuts?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуть стандартные ярлыки?"
