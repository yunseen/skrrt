      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые страницы появятся здесь."
          }
        }
      }
    },
    "No History": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История пуста"
          }
        }
      }
